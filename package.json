{
  "name": "emoji-bot",
  "version": "0.2.3",
  "main": "src/index.ts",
  "author": "@camilla_ett",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "watch": "npm run build:live",
    "build": "tsc -p .",
    "build:live": "nodemon --watch 'src/**/*.ts' --exec \"ts-node\" src/index.ts",
    "start": "ts-node src/index.ts",
    "lint": "eslint --fix .",
    "api:build": "aspida"
  },
  "dependencies": {
    "@aspida/axios": "^1.14.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
